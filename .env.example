# Public values from the Supabase project's Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Server-only value. Never expose this in NEXT_PUBLIC_* variables or the browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Future integrations: leave unset until their stages are implemented and approved.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# GEOAPIFY_API_KEY=
# PAYMENT_PROVIDER_MODE=test
